# Pin for Medtronic-LABS/healthcare_fhir_gateway, the read-only FHIR R4 API app this image installs
# alongside spice_facility (required_apps=["healthcare"], no shared code with spice_facility -- it
# just needs to be on the same site). Lives here, not in docker/base/versions.env: fhir_gateway is
# app-layer, like spice_facility itself, so a new commit there should rebuild in minutes, not force
# a base-image rebuild.
#
# Pinned by commit, not just a floating branch, for the same reason versions.env pins everything
# else: the same tag always producing the same build. To upgrade: bump the commit (and the ref, if
# it changes) to a real commit on the healthcare_fhir_gateway repo, open a PR, merge.
FHIR_GATEWAY_REF=main
FHIR_GATEWAY_COMMIT=59fcb235730d603cd60536930d7d1664155daef9
