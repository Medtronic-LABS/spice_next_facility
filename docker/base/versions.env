# The ONLY place the reused base stack is versioned. The pipeline rebuilds the base image
# (ghcr.io/medtronic-labs/spice_next_facility-base) only when this file or docker/base/Dockerfile
# changes; every other push reuses it and adds just the spice_facility layer.
#
# Each upstream is pinned twice: the release tag (what to clone) and the commit it must resolve to. The
# build fails if a tag has been moved, so the same file always produces the same code. The bench image
# is pinned by digest for the same reason.
#
# To upgrade: change a tag AND its commit (git ls-remote https://github.com/<repo>.git 'refs/tags/<tag>*'),
# bump BASE_REVISION if you need a rebuild without a version change, open a PR, merge.

# frappe/bench image the base is built on (tag for humans, digest for the build)
BENCH_IMAGE=frappe/bench:v5.31.0@sha256:8c500a20cb1933d0427c1568dcf3c8c37021c0e07be1ac268539fd7fe14ef557
FRAPPE_REF=v16.51.0
FRAPPE_COMMIT=6b450a166e076dd842e4db7ea0843f62881e62ac
ERPNEXT_REF=v16.50.0
ERPNEXT_COMMIT=7474d9e786277383de1242ab882f16856d17a9c9
HEALTHCARE_REF=v16.6.1
HEALTHCARE_COMMIT=dda107b26e3a0fe1dbd65c7257371235de054a04
FRAPPE_THEME_REF=v0.9.9
FRAPPE_THEME_COMMIT=757bb948bd2d36e8a22e22cc521978e9717aed54
BASE_REVISION=2
