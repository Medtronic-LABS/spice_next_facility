# Public entry point.
#   DOMAIN=spice-facility-dev.labsplatform.com          HTTPS via Let's Encrypt (auto-renewed); http:// redirects to https://
#   DOMAIN=http://spice-facility-dev.labsplatform.com   plain HTTP only (e.g. TLS terminated by an ALB in front)
#   DOMAIN unset                                        plain HTTP on :80 for any host (first boot, before DNS exists)
# Let's Encrypt needs the DNS A record to point at this instance and ports 80 + 443 open.
{$DOMAIN} {
	encode gzip

	# Realtime (socket.io) is served by the app's node process on 9000.
	@socketio path /socket.io/*
	reverse_proxy @socketio app:9000 {
		header_up Host {$SITE_NAME}
		header_up X-Frappe-Site-Name {$SITE_NAME}
	}

	reverse_proxy app:8000 {
		header_up Host {$SITE_NAME}
		header_up X-Frappe-Site-Name {$SITE_NAME}
		transport http {
			read_timeout 180s
		}
	}

	request_body {
		max_size 50MB
	}
}
