# deploy/.env on the EC2 host is written by the deploy job from that GitHub environment's variables and
# secrets on every deploy (values single-quoted); this file only documents the variables. Never commit a
# real .env.

# Image to run (set by the pipeline to the immutable sha tag it just built and tested)
IMAGE_TAG=sha-0000000
GHCR_OWNER=medtronic-labs

# Site (dev shown; training uses spice-facility-training.labsplatform.com)
# Frappe site name
SITE_NAME=spice-facility-dev.labsplatform.com
# public hostname: bare host = HTTPS (http redirects); "http://host" = plain HTTP; empty = HTTP on :80
DOMAIN=spice-facility-dev.labsplatform.com
# Administrator password, used only when the site is first created
ADMIN_PASSWORD=change-me

# MariaDB (container on this host)
# used by MariaDB and by bench new-site; the site itself gets a scoped user
DB_ROOT_PASSWORD=change-me
# ~50% of the RAM you can give MariaDB
DB_BUFFER_POOL=1G
# MariaDB CLI client TLS: off = the bundled container (private Docker network, no TLS offered).
# verify (+ DB_SSL_CA) exists for a future external server such as RDS but is not wired through the deploy
# yet (see docs/deployment/aws-ec2.md, "Next steps").
DB_TLS=off

# AI: no local model on this deployment. Claude/OpenAI keys are set in SPICE AI Settings (encrypted)
# or here as overrides.
SPICE_AI_OLLAMA_ENABLED=0
SPICE_AI_OLLAMA_URL=
# SPICE_AI_ANTHROPIC_API_KEY=
# SPICE_AI_OPENAI_API_KEY=

# Backups (daily bench backup --with-files). On EC2 the instance role grants S3 access: no keys here.
BACKUP_S3_BUCKET=
AWS_DEFAULT_REGION=ap-south-1
BACKUP_RETENTION_DAYS=7
ALERT_WEBHOOK_URL=
