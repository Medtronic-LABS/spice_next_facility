 "fields": [
  {
   "fieldname": "providers_tab",
   "fieldtype": "Tab Break",
   "label": "Providers"
  },
  {
   "fieldname": "ollama_section",
   "fieldtype": "Section Break",
   "label": "Ollama (local)",
   "description": "Runs on this server; patient data never leaves it. Used for summaries, record questions and every written answer."
  },
  {
   "fieldname": "ollama_enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1"
  },
  {
   "fieldname": "ollama_url",
   "fieldtype": "Data",
   "label": "Server URL",
   "default": "http://ollama:11434",
   "depends_on": "ollama_enabled"
  },
  {
   "fieldname": "ollama_model",
   "fieldtype": "Autocomplete",
   "label": "Model",
   "default": "llama3.1:8b",
   "depends_on": "ollama_enabled",
   "description": "Type a model name, or use \u201cRefresh models\u201d to pick from what this provider offers."
  },
  {
   "fieldname": "ollama_col",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "ollama_keep_alive",
   "fieldtype": "Data",
   "label": "Keep model loaded for",
   "default": "30m",
   "depends_on": "ollama_enabled",
   "description": "Avoids the ~90s cold load between requests (Ollama keep_alive)."
  },
  {
   "fieldname": "ollama_timeout",
   "fieldtype": "Int",
   "label": "Timeout (seconds)",
   "default": "300",
   "depends_on": "ollama_enabled"
  },
  {
   "fieldname": "ollama_temperature",
   "fieldtype": "Float",
   "label": "Temperature",
   "default": "0.1",
   "precision": "2",
   "depends_on": "ollama_enabled"
  },
  {
   "fieldname": "ollama_in_chat",
   "fieldtype": "Check",
   "label": "Offer in chat",
   "default": "1",
   "depends_on": "ollama_enabled"
  },
  {
   "fieldname": "ollama_status",
   "fieldtype": "HTML",
   "label": "Status"
  },
  {
   "fieldname": "claude_section",
   "fieldtype": "Section Break",
